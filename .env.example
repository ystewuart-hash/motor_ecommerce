# Copiar a .env y completar. .env NUNCA se versiona (ver .gitignore).
# Referencia completa: docs/infraestructura_produccion_sprint4.md

# --- Base de datos ---
DATABASE_URL=postgresql+psycopg://usuario:contraseña@localhost:5432/ecommerce_db

# --- Administrador (provisional, hasta tener tabla de usuarios) ---
ADMIN_USER=admin
# Recomendado: hash Argon2 generado con  python -m core.security hash
# (entre comillas simples: el hash contiene '$')
ADMIN_PASSWORD_HASH=''
# Solo desarrollo: contraseña en texto plano (se ignora si hay ADMIN_PASSWORD_HASH)
# ADMIN_PASSWORD=

# --- JWT ---
# Generar con:  python -m core.security secreto   (mínimo 32 caracteres)
JWT_SECRET_KEY=
JWT_EXPIRACION_MINUTOS=30

# --- CORS: orígenes del frontend separados por comas ---
CORS_ORIGINS=http://localhost:3000

# --- Rate limiting (sintaxis: N/second|minute|hour|day) ---
RATE_LIMIT_HABILITADO=true
# memory:// = un solo proceso. Con varios workers/servidores: redis://host:6379/0
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_SEGUIMIENTO=30/minute
RATE_LIMIT_FALLOS_LOGIN=10/hour
RATE_LIMIT_FALLOS_SEGUIMIENTO=10/day

# --- Tareas programadas ---
SCHEDULER_HABILITADO=true
JOB_VENCIDOS_INTERVALO_MINUTOS=60
PEDIDOS_VENCEN_HORAS=48

# --- Logging ---
LOG_NIVEL=INFO
# json (producción) | consola (desarrollo, legible y con colores)
LOG_FORMATO=json
LOG_UMBRAL_LOCK_LENTO_MS=100
